# --- gateway ---
SPANGUARD_MODE=fast            # rules | fast | audit
SPANGUARD_MODEL=Nabidnur/spanguard-span-mdistil
SPANGUARD_THRESHOLD=0.5
SPANGUARD_HOST=127.0.0.1
SPANGUARD_PORT=8819
SPANGUARD_API_TOKEN=           # set a bearer token before exposing beyond localhost

# --- upstream (the model behind the gateway) ---
SPANGUARD_UPSTREAM_URL=https://inference.baseten.co/v1
SPANGUARD_UPSTREAM_MODEL=meta-models/muse-spark-open-1026
BASETEN_API_KEY=               # Meta open weights on Baseten (hackathon Model API)
# META_API_KEY=                # or the Meta Model API (muse-spark-1.3) when available

# --- audit mode (opt-in; sends the STRIPPED text to the LLM) ---
SPANGUARD_AUDIT_BASE_URL=https://inference.baseten.co/v1
SPANGUARD_AUDIT_MODEL=meta-models/muse-spark-open-1026

# --- inspection scope ---
SPANGUARD_INSPECT_SYSTEM=1
SPANGUARD_INSPECT_USER=1
